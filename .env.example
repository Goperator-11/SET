# docker compose 가 읽는 설정입니다. 이 파일을 .env 로 복사해서 값을 채우세요.
# setup.sh 를 쓰면 자동으로 만들어 줍니다.

# 서버컴에서 열어줄 포트. Cloudflare Tunnel 을 쓰면 이 포트는 열리지 않습니다.
HOST_PORT=3000

# 두 번째 사람부터 가입할 때 필요한 초대코드.
# 혼자 쓰실 거면 비워두세요. 그러면 첫 계정 하나만 만들어지고 가입이 닫힙니다.
INVITE_CODE=

# HTTPS 로 접속한다면 true. Cloudflare Tunnel 을 쓰면 반드시 true 여야 합니다.
# (false 로 두면 브라우저가 HTTPS 페이지에서 쿠키를 안 보내 로그인이 풀립니다)
COOKIE_SECURE=false

# 실제 접속 주소. 리버스 프록시나 Cloudflare 뒤에 있을 때 꼭 지정하세요.
# 비워두면 Host 헤더로 판단하는데, 프록시가 Host 를 바꾸면 로그인 요청이 403 이 됩니다.
#   예)  APP_ORIGIN=https://study.example.com
APP_ORIGIN=

# Cloudflare Tunnel 토큰. 터널을 쓸 때만 필요합니다.
#   Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared
#   Public hostname 의 Service 는  http://nightshift:3000  으로 지정하세요.
TUNNEL_TOKEN=
